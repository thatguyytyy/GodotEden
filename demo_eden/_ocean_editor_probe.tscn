[sub_resource type="Shader" id="Shader_f6ke8"]
code = "// Planetary ocean surface. Port of boujie_water_shader (MIT, (c) 2023 Zach Bernal and contributors,
#define EDEN_OCEAN_FAST_SKY_LIGHT
#define EDEN_OCEAN_FAST_LIGHT
// https://github.com/Chrisknyfe/boujie_water_shader) from a flat +Y ocean to a sphere.
//
// What changed vs. upstream, and why:
//  - \"Up\" is normalize(VERTEX - planet_center), not +Y, and Gerstner waves are evaluated on three
//    world-axis planes and blended by the sphere normal (triplanar), so the wave field is seamless
//    over the whole planet -- no cube-face or pole seams. Upstream's rotate_to_normal() is gone.
//  - Depth fog colour goes to ALBEDO (lit), not EMISSION. Upstream emits color_deep unlit, which on
//    a planet makes the whole night side glow blue. The refracted screen colour stays in EMISSION:
//    it is the scene's already-lit colour, so it is correct either way.
//  - DISTANCE_FADE defaults to \"never\": a planet ocean seen from orbit must not fade out.
//  - Waves follow a baked ocean-current cubemap (EdenPlanetOcean bakes it), LOD patches geomorph
//    into their parent, and there is a low-poly flat-normal mode.
//  - Gerstner normals are the analytic normals of the displacement the same wave produces (upstream
//    used F * A for the slope, i.e. with no amplitude in it -- it shaded metre-high swell as a flat
//    sheet, which is what made the sea read as scaleless).
//  - Foam is the wave field's own fold (the Gerstner steepness term), not a separate wave set, and
//    the foam/refraction detail drifts along the local current. Upstream's FoamWave* group is gone.
//  - Performance: back faces are discarded above water (they were the whole far side of the
//    planet, shaded under the near surface), and the screen copy has no mip chain.

shader_type spatial;

// shadows_disabled: sampling the sun/moon shadow cascades on every water pixel cost 1-2.5 ms at
// 1080p on a GTX 750 Ti, for shadows that barely read on a transparent, mostly-reflective surface.
// EDEN_OCEAN_FAST_SKY_LIGHT (EdenPlanetOcean.fast_sky_lighting, the default) swaps Godot's sky
// ambient + radiance reflections -- ~2.5 ms at 1080p on a GTX 750 Ti -- for a tiny sky map and an
// ambient cube (see FastSkyLight). Sun and moon direct light stay Godot's either way.
// EDEN_OCEAN_FAST_LIGHT (lighting_mode = Fast) goes further: unshaded, with the sun/moon lit here
// by the same Burley + GGX BRDF Godot uses (see fast_direct_light), for the lights EdenPlanetOcean
// pushes. Skips Godot's whole per-pixel light loop; omni/spot lights no longer light the water.
// world_vertex_coords is deliberately NOT used. It would hand the vertex shader positions ~40000
// units from the planet centre, and a float32 that large is quantised to about 4 mm -- fine for the
// surface itself, but it destroys anything that differentiates position. A screen-space face normal,
// cross(dFdx(VERTEX), dFdy(VERTEX)), differentiates over a pixel footprint of a millimetre or two up
// close, so it came out as pure rounding noise that re-rolled every frame: the low-poly mode's
// facets collapsed to pixel-quad size and shimmered. Vertices stay in patch-local space (ten metres
// at most, so ~1e-6 precision), the wave field is evaluated at an explicitly transformed world
// position, and `local_pos` carries the precise one to the fragment stage for the face normal.
#if defined(EDEN_OCEAN_FAST_LIGHT)
render_mode unshaded, blend_mix, depth_draw_always, cull_disabled;
#elif defined(EDEN_OCEAN_FAST_SKY_LIGHT)
render_mode blend_mix, depth_draw_always, cull_disabled, shadows_disabled, ambient_light_disabled, diffuse_burley, specular_schlick_ggx;
#else
render_mode blend_mix, depth_draw_always, cull_disabled, shadows_disabled, diffuse_burley, specular_schlick_ggx;
#endif

group_uniforms Style;
// Flat per-triangle normals: a faceted low-poly sea. Also switches the foam to hard-edged
// polygonal caps (see the Foam group). Pairs well with a lower grid_resolution.
uniform bool low_poly_normals = false;
// A facet is one mesh triangle -- about a metre at LOD0 (min_leaf_world_size / grid_resolution) and
// never smaller, since that is the finest the quadtree builds. Set those two to change the size.
//
// Facet tilt exaggeration. A real 1.4 m sea slopes about two degrees, so the amount of wave a 1 m
// triangle misses is a couple of centimetres: flat-shade it honestly and every facet comes out at
// almost the same angle, which is a smooth sea with extra steps. Stylised low-poly water reads
// because its facets sit at clearly different angles, so the face normal (and only the face normal
// -- geometry, silhouette and the smooth-shaded mode are untouched) is tilted away from the local
// vertical by this factor. 1 is physical and looks like nothing.
uniform float low_poly_relief : hint_range(1.0, 12.0) = 2.0;
// Stop flat-shading once triangles are coarser than this; past it a facet is a slab, not a style.
uniform float low_poly_max_facet : hint_range(0.5, 64.0) = 16.0;
// Paint the baked current field (hue = direction, brightness = strength) instead of water.
uniform bool debug_show_currents = false;
group_uniforms;

// Set by EdenPlanetOcean every LOD pass.
uniform vec3 planet_center = vec3(0.0);
uniform float planet_radius = 20000.0;
// Triplanar blend of the wave planes. Sharp, because every plane with weight costs a full wave
// evaluation per vertex; with 8 most of the sphere needs only one.
uniform float wave_blend_sharpness = 8.0;

uniform bool freeze_time = false;
uniform vec4 albedo : source_color = vec4(0.235, 0.647, 0.961, 0.0);
uniform vec4 albedo_fresnel : source_color = vec4(0.318, 0.596, 0.988, 1.0);
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float specular : hint_range(0.0, 1.0) = 0.26;
uniform float roughness : hint_range(0.0, 1.0) = 0.09;
uniform float metallic : hint_range(0.0, 1.0) = 0.0;

group_uniforms FastSkyLight;
// Only used with fast_sky_lighting. A sibling EdenPlanetAtmosphere pushes these every frame (not
// saved): a small world-space equirect of sky radiance seen from the camera -- what Godot's own
// radiance cubemap is, at a fraction of the size -- and an ambient cube (cosine-weighted
// irradiance along +-X/Y/Z). Without an atmosphere, sky_fallback_color stands in for both.
uniform bool sky_map_valid = false;
uniform sampler2D sky_radiance_map : filter_linear, repeat_enable, hint_default_black;
uniform vec3 sky_ambient_px;
uniform vec3 sky_ambient_nx;
uniform vec3 sky_ambient_py;
uniform vec3 sky_ambient_ny;
uniform vec3 sky_ambient_pz;
uniform vec3 sky_ambient_nz;
uniform vec3 sky_fallback_color = vec3(0.55, 0.7, 0.9);
// Calibration against Godot's own sky lighting (fit on water brightness at noon/sunset/night).
uniform float sky_light_energy : hint_range(0.0, 2.0) = 0.8;
group_uniforms;

group_uniforms FastLight;
// Pushed every frame by EdenPlanetOcean (not saved); only used with lighting_mode = Fast.
// direction points TO the light (world); color = linear colour * energy * PI, as Godot builds it.
uniform int fast_light_count = 0;
uniform vec3 fast_light_direction[2];
uniform vec3 fast_light_color[2];
uniform float fast_light_specular[2];
// Godot's directional light size term (1 - cos(angular size)), 0 unless soft directional shadows are on; see
// EdenPlanetOcean::_update_fast_lights
uniform float fast_light_size[2];
// Godot's screen-space roughness limiter (project settings, amount 0 = off), which its shaded path applies to direct
// light. Unshaded, Fast has to apply it itself: without it the sun glint on distant water, where normals change from
// pixel to pixel, was a tight dim spot instead of Fast Sky's broad bright one.
uniform float fast_roughness_limiter_amount = 0.25;
uniform float fast_roughness_limiter_limit = 0.18;
group_uniforms;

group_uniforms Ripples;
// Foam around objects in the \"ocean_ripple\" group, from the true distance to each object's waterline.
// EdenPlanetOcean slices the object's actual mesh every frame at RIPPLE_SLICES heights across its
// vertical extent (in a frame tangent to the planet at the object), giving the outline where a water
// surface at that height would cut it. Per pixel, the water's own wave-displaced height picks the two
// slices around it and the foam comes from the exact 2D distance to that outline -- so a swell washing
// up the object gets foam hugging the shape at that height, and water below or above it gets none.
// Colour only; normals are untouched. Per-object data is pushed every frame (not saved):
//   ripple_segments: row = object * RIPPLE_SLICES + slice; texel 0 = (segment count, outline
//                    radius), texels 1.. = (x0, y0, x1, y1) in the object's (east, north) frame, metres
//   ripple_origin  : xyz frame origin (world), w foam strength
//   ripple_up      : xyz frame up, w horizontal bounding radius
//   ripple_east    : xyz frame east, w height of the lowest slice;  ripple_zmax: of the highest
uniform float ripple_contact_width : hint_range(0.0, 5.0) = 0.45;
uniform float ripple_line_spacing : hint_range(0.1, 10.0) = 1.1;
uniform float ripple_line_width : hint_range(0.01, 1.0) = 0.45;
uniform float ripple_reach : hint_range(0.5, 50.0) = 4.5;
uniform float ripple_speed : hint_range(0.0, 5.0) = 0.35;
// 0 = unbroken lines, 1 = mostly torn apart by noise.
uniform float ripple_breakup : hint_range(0.0, 1.0) = 0.45;
// Metres the contours wander by (noise), so foam edges waver instead of tracing perfect offsets.
uniform float ripple_warp : hint_range(0.0, 3.0) = 0.6;
uniform float ripple_foam : hint_range(0.0, 1.0) = 1.0;
// How much the local current shapes the collar: 0 = the same contour on every side (what upstream
// drew, which reads as a topographic map), 1 = foam piled on the upstream face and streaming away
// downstream. Scaled by the current's strength, so slack water keeps an even collar either way.
uniform float ripple_wake : hint_range(0.0, 1.0) = 1.0;
uniform vec4 ripple_color : source_color = vec4(0.97, 0.99, 1.0, 1.0);
// A thin tinted line just outside the foam collar; alpha 0 turns it off.
uniform vec4 ripple_edge_color : source_color = vec4(0.25, 0.95, 0.55, 0.0);
uniform int ripple_count = 0;
uniform sampler2D ripple_segments : filter_nearest, repeat_disable;
uniform vec4 ripple_origin[16];
uniform vec4 ripple_up[16];
uniform vec4 ripple_east[16];
uniform float ripple_zmax[16];
group_uniforms;

group_uniforms ScreenSpaceReflections;
// Only with EdenPlanetOcean.screen_space_reflections (and a Fast / Fast Sky lighting_mode): the
// reflected view ray is marched through the depth buffer, and where it hits scene geometry that
// replaces the sky in the reflection. Adapted from the \"Transparent Water Shader supporting SSR\"
// on godotshaders.com (non-uniform step spacing and a binary refine added).
uniform int ssr_steps : hint_range(4, 64) = 16;
uniform float ssr_max_distance : hint_range(1.0, 2000.0) = 150.0;
uniform float ssr_thickness : hint_range(0.05, 50.0) = 2.0;
uniform float ssr_strength : hint_range(0.0, 1.0) = 1.0;
group_uniforms;

group_uniforms Currents;
// current_map / current_enabled are pushed by EdenPlanetOcean (not saved with the material).
uniform samplerCube current_map : filter_linear;
uniform bool current_enabled = false;
// 0: waves keep their authored directions. 1: the wave set is rotated to run with the current.
uniform float current_direction_influence : hint_range(0.0, 1.0) = 1.0;
// How much weak-current water calms down (wave height scales toward the current's strength).
uniform float current_amplitude_influence : hint_range(0.0, 1.0) = 0.5;
group_uniforms;

group_uniforms LodBlend;
// Metres between neighbouring vertices per metre of a patch's lod_range; EdenPlanetOcean pushes
// 1 / (2 * split_distance_factor * grid_resolution). A wave shorter than about two vertex spacings
// cannot be sampled by that patch, and left in it does not just disappear -- it aliases into
// coherent low-frequency blotches tens of metres across, which is what painted whole hillsides of
// the far sea solid with foam. wave_sum fades each wave out as it approaches that limit instead.
uniform float lod_vertex_spacing = 0.025;
uniform bool lod_blend = true;
// Fraction of a patch's merge distance at which it starts morphing into its parent.
uniform float lod_morph_start : hint_range(0.0, 0.99) = 0.75;
// Back faces are only shaded when the camera is below this altitude (underwater views).
uniform float backface_altitude = 10.0;
group_uniforms;

group_uniforms Refraction;
uniform sampler2D texture_refraction : filter_linear_mipmap, repeat_enable;
uniform float refraction : hint_range(-2, 2) = 0.022;
uniform vec4 refraction_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
uniform float refraction_opacity : hint_range(0.0, 1.0) = 1.0;
// Metres of water between the surface and the object behind it at which refraction reaches full
// strength. A screen-space offset is the same size however close the object is, so an object just
// under the surface got its colour flung right across the water; scaling the offset by the depth
// actually behind the pixel keeps it a small blur at the waterline that widens as the object sinks.
uniform float refraction_depth_scale : hint_range(0.05, 20.0) = 1.5;
group_uniforms;

group_uniforms Foam;
uniform sampler2D texture_foam : source_color, filter_linear_mipmap, repeat_enable;
// Whitecaps come from the wave field's own fold -- the Gerstner steepness term sum(Q * k * a * sin),
// which peaks on crests and where wave trains meet, so foam sits on the waves by construction and
// runs with them. 0 is flat water; 1 is a breaking cusp, and the built-in spectrum peaks at ~0.30
// (it is sum(Q * k * a), so a steeper or taller spectrum raises the ceiling and wants these raised).
uniform float foam_crest_start : hint_range(0.0, 1.0) = 0.06;
uniform float foam_crest_full : hint_range(0.0, 1.0) = 0.115;
// How much the foam texture RAISES the crest threshold where it is transparent, rather than simply
// dimming the foam there. Multiplying by the texture's alpha washed every whitecap out to the
// texture's own average; biting into the threshold instead leaves solid white caps with torn edges.
uniform float foam_texture_bite : hint_range(0.0, 0.5) = 0.06;
uniform float foam_amount : hint_range(0.0, 2.0) = 1.0;
// Metres/second the foam and refraction detail drift along the local current. With no current baked
// they simply hold still (the crests still move).
uniform float foam_drift_speed : hint_range(0.0, 10.0) = 1.5;
// low_poly_normals only: how much of a whitecap the hard-edged foam blobs cover.
uniform float foam_low_poly_coverage : hint_range(0.0, 1.0) = 0.6;
uniform float shore_start_blend = 0.5;
uniform float shore_end_blend = 3.0;
group_uniforms;

group_uniforms DistanceFade;
uniform float distance_fade_min = 1e9;
uniform float distance_fade_max = 2e9;
uniform float near_fade_min = 0.05;
uniform float near_fade_max = 0.1;
group_uniforms;

group_uniforms FeatureFade;
uniform float foam_fade_min = 500.0;
uniform float foam_fade_max = 1500.0;
uniform float shore_fade_min = 500.0;
uniform float shore_fade_max = 1500.0;
uniform float vertex_wave_fade_min = 500.0;
uniform float vertex_wave_fade_max = 1500.0;
uniform float depth_fog_fade_min = 1500.0;
uniform float depth_fog_fade_max = 6000.0;
uniform float refraction_scaling_distance_min = 50.0;
group_uniforms;

group_uniforms WorldTriplanarUvs;
// Higher = narrower plane blends = most pixels sample one plane instead of three.
uniform float uv_blend_sharpness = 8.0;
uniform vec3 uv_tri_scale = vec3(36.0);
uniform vec3 uv_tri_offset = vec3(0.0);
group_uniforms;

group_uniforms DepthFog;
// Metres either side of sea level in which a depth-buffer hit is assumed to be the ocean itself
// rather than a sea floor (see depth_from_water_to_object). Off by default: every sea floor within
// the band reads as deep water, which at 3.5 m painted a dark deep-water strip along every beach
// and switched the shore foam off. A depth-hit capture (demo_eden/_shore_capture.gd --debug-depth,
// 2026-09-28) found no depth reads landing on the water itself, in the open sea or at grazing
// angles; raise it only if hard-edged shallow-colour slabs along the crests come back.
uniform float floor_reject_band : hint_range(0.0, 20.0) = 0.0;
uniform vec4 color_deep : source_color = vec4(0.02, 0.09, 0.26, 1.0);
uniform vec4 color_shallow : source_color = vec4(0.05, 0.45, 0.5, 0.25);
uniform float beers_law = 0.08;
uniform float depth_offset = -1.0;
group_uniforms;

group_uniforms SnellWindow;
uniform vec4 albedo_snell : source_color = vec4(0.0, 0.102, 0.239, 1.0);
uniform float snell_tightness : hint_range(0.0, 1.0) = 0.6;
group_uniforms;

// Wave arrays, upstream's layout. With currents on, directions are relative to the local current
// (0 = straight downstream). Per wave i, along its direction D:
//   height     = WaveSteepnesses[i] / WaveCount * sin(TAU * F * x + Sp * t)
//   horizontal = WaveAmplitudes[i] (the Gerstner steepness Q, 0..1) times that
// so WaveSteepnesses is the wave height in metres * WaveCount, and 1 / WaveFrequencies is the
// wavelength in metres. Speeds should match deep-water dispersion, Sp = TAU * 1.25 / sqrt(L); off
// that, waves of different sizes drift through each other at the wrong rate and the sea reads as a
// scrolling texture instead of water.
group_uniforms WaveParameters;
uniform int WaveCount : hint_range(0, 8) = 0;
uniform float WaveSteepnesses[8];
uniform float WaveAmplitudes[8];
uniform float WaveDirectionsDegrees[8];
uniform float WaveFrequencies[8];
uniform float WaveSpeeds[8];
uniform float WavePhases[8];
group_uniforms;

group_uniforms UVWaveParameters;
uniform int UVWaveCount : hint_range(0, 8) = 0;
uniform float UVWaveSteepnesses[8];
uniform float UVWaveAmplitudes[8];
uniform float UVWaveDirectionsDegrees[8];
uniform float UVWaveFrequencies[8];
uniform float UVWaveSpeeds[8];
uniform float UVWavePhases[8];
group_uniforms;

// No mipmaps: a mipmapped screen texture makes Godot blur-chain the whole screen every frame.
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform sampler2D depth_texture : hint_depth_texture, filter_nearest;

varying vec3 uv_tri;
varying vec3 refraction_uv_tri;
varying vec3 uv_power_normal;
varying float wave_fold; // Gerstner steepness sum at this vertex: the whitecap mask
varying float low_poly_fade; // 1 where this patch's triangles are small enough to flat-shade
// Patch-local displaced position (see the note by render_mode): metres from the patch origin, so
// its screen-space derivatives are exact and give the true face normal of the triangle.
varying vec3 local_pos;
// `flat`: the whole triangle takes its provoking vertex's value, so the whitecap mask is constant
// across a facet and foam turns a whole triangle white instead of cutting across it.
varying flat float facet_fold;
varying vec3 world_coordinates;
varying vec4 current_sample;
varying float skirt; // > 0 anywhere inside a skirt triangle (CUSTOM0.w = 1 on its lower vertices)

// abs(), not clamp(). A wave slope tilts its normal past the view direction whenever the view is
// shallower than the wave is steep, which from any height happens a few hundred metres out. Clamping
// the dot product at zero pins this term at full reflection across every such slope -- a flat
// mirror-bright slab with a hard edge where the clamp starts biting, which striped the middle
// distance. abs() carries straight through grazing instead: the term peaks and comes back down, so
// the far side of a wave shades like the near side rather than like a mirror.
float fresnel(float amount, vec3 normal, vec3 view) {
	return pow(1.0 - abs(dot(normalize(normal), normalize(view))), amount);
}

float snell(float amount, vec3 normal, vec3 view) {
	return step(amount, clamp(dot(normalize(normal), normalize(view)), 0.0, 1.0));
}

// Gerstner position and normal in one go, sharing the trig. Flat plane: x/z along the plane, y up.
// The normal is the analytic normal of THIS displacement: slope k * S along dir, crest-sharpened by
// the steepness A. (Upstream used F * A, which contains no amplitude at all, so raising the waves
// did nothing to the shading -- metre-high swell came out looking like a flat mirror.) Both outputs
// are pre-division by the wave count, which wave_sum applies to the two together, so they stay
// consistent: the slope of the summed displacement is exactly the summed normal's.
void gerstner(vec2 c, float t, float S, float A, float D, float F, float Sp, float Ph, out vec3 pos, out vec3 nrm) {
	vec2 dir = vec2(sin(radians(D)), cos(radians(D)));
	float k = TAU * F;
	float ph = k * dot(dir, c) + Sp * (t + radians(Ph));
	float s = sin(ph);
	float co = cos(ph);
	pos = vec3(S * A * dir.x * co, S * s, S * A * dir.y * co);
	nrm = vec3(-dir.x * k * S * co, 1.0 - A * k * S * s, -dir.y * k * S * co);
}

void wave_params(int group, int i, out float S, out float A, out float D, out float F, out float Sp, out float Ph) {
	if (group == 0) {
		S = WaveSteepnesses[i]; A = WaveAmplitudes[i]; D = WaveDirectionsDegrees[i];
		F = WaveFrequencies[i]; Sp = WaveSpeeds[i]; Ph = WavePhases[i];
	} else {
		S = UVWaveSteepnesses[i]; A = UVWaveAmplitudes[i]; D = UVWaveDirectionsDegrees[i];
		F = UVWaveFrequencies[i]; Sp = UVWaveSpeeds[i]; Ph = UVWavePhases[i];
	}
}

// Baked current at sphere direction `up`: xyz = world-space tangent direction, w = strength 0..1.
vec4 sample_current(vec3 up) {
	if (!current_enabled) {
		return vec4(0.0, 0.0, 0.0, 1.0);
	}
	vec4 c = textureLod(current_map, up, 0.0);
	return vec4(c.rgb * 2.0 - 1.0, c.a);
}

// `spacing` is the distance between this patch's vertices, for band limiting; 0 disables it (the
// UV-detail waves live in texture space, where a world-space spacing means nothing).
// Triplanar Gerstner sum at world point p with sphere-up `up`, blend weights w.
// Returns xyz = averaged displacement (world directions), w = the fold: sum(Q * k * a * sin) over
// the wave set, which is 0 on flat water and 1 where the surface folds over itself. That is exactly
// the term the normal's up component is 1 minus, so it comes for free and marks crests and the
// places where wave trains pile into each other -- the whitecap mask. `nrm` = averaged normal
// (unnormalised). Plane k's two in-plane world axes are flattened onto the local tangent plane so
// their horizontal motion never pushes the surface off the sphere.
//
// Currents: rotating each wave's direction continuously across space would shear its phase field
// (phase = F * dot(dir(p), p) with |p| ~ planet radius), so the wave set is instead evaluated at the
// two nearest of 8 fixed 45-degree rotations of the current's heading and cross-faded. Most of the
// sea sits in a single bin (the fade band is the middle 20% of each bin), so the cost is ~1.2x.
// ponytail: horizontal Gerstner motion partially cancels where planes blend (~45 deg latitudes);
// swap for a per-face cube parametrisation if that ever shows.
vec4 wave_sum(int group, int count, vec3 p, vec3 up, vec3 w, float t, vec4 cur, float spacing, out vec3 nrm) {
	vec3 disp = vec3(0.0);
	float fold = 0.0;
	nrm = vec3(0.0);
	// Only the height waves follow the current: foam and UV-detail waves are texture-scale noise
	// where direction doesn't read, and binning them doubled their cost.
	bool follow = group == 0 && current_enabled && current_direction_influence > 0.0 && dot(cur.xyz, cur.xyz) > 1e-4;
	for (int k = 0; k < 3; k++) {
		if (w[k] <= 0.0) {
			continue;
		}
		vec2 c;
		vec3 a;
		vec3 b;
		if (k == 0) { c = p.zy; a = vec3(0.0, 0.0, 1.0); b = vec3(0.0, 1.0, 0.0); }
		else if (k == 1) { c = p.xz; a = vec3(1.0, 0.0, 0.0); b = vec3(0.0, 0.0, 1.0); }
		else { c = p.xy; a = vec3(1.0, 0.0, 0.0); b = vec3(0.0, 1.0, 0.0); }

		// Heading of the current in this plane's (a, b) coordinates. Gerstner crests travel toward
		// -dir, hence the negation: direction 0 then runs downstream.
		float rot0 = 0.0;
		float fade = 0.0;
		if (follow) {
			float heading = degrees(atan(-dot(cur.xyz, a), -dot(cur.xyz, b))) * current_direction_influence;
			float f = heading / 45.0;
			float fb = floor(f);
			rot0 = fb * 45.0;
			fade = smoothstep(0.4, 0.6, f - fb);
		}

		a -= up * dot(a, up);
		b -= up * dot(b, up);
		for (int i = 0; i < count; i++) {
			float S, A, D, F, Sp, Ph;
			wave_params(group, i, S, A, D, F, Sp, Ph);
			if (spacing > 0.0) {
				// Wavelength measured in vertex spacings, faded out as it approaches what this patch
				// can carry. Keep this close to Nyquist: it was briefly six samples per wavelength,
				// on the theory that the creases in an under-sampled crest were what striped the
				// middle distance (they were not -- that was back faces being discarded and then
				// Snell-shaded, see water_top). Six throws away most of the spectrum as soon as the
				// triangles are more than a metre or two: at 4.88 m facets nothing under 29 m
				// survived, and every LOD level past the first was flat water.
				S *= smoothstep(1.5, 3.0, 1.0 / max(F * spacing, 1e-9));
				if (S == 0.0) {
					continue;
				}
			}
			vec3 r;
			vec3 n;
			vec3 r_sum = vec3(0.0);
			vec3 n_sum = vec3(0.0);
			if (fade < 1.0) {
				gerstner(c, t, S, A, D + rot0, F, Sp, Ph, r, n);
				r_sum += r * (1.0 - fade);
				n_sum += n * (1.0 - fade);
			}
			if (fade > 0.0) {
				gerstner(c, t, S, A, D + rot0 + 45.0, F, Sp, Ph, r, n);
				r_sum += r * fade;
				n_sum += n * fade;
			}
			disp += w[k] * (a * r_sum.x + up * r_sum.y + b * r_sum.z);
			fold += w[k] * (1.0 - n_sum.y);
			nrm += w[k] * (a * n_sum.x + up * n_sum.y + b * n_sum.z);
		}
	}
	float inv = 1.0 / float(max(count, 1));
	float calm = mix(1.0, cur.w, current_amplitude_influence);
	nrm *= inv;
	// Calmer water: shrink the displacement and flatten the normal's slope together.
	nrm = up + (nrm - up) * calm;
	return vec4(disp, fold) * inv * calm;
}

// Triplanar plane weights for the waves. Weights under 5% are removed continuously (subtract,
// clamp, renormalise) rather than cut off, so no seam appears where a plane drops out.
vec3 wave_weights(vec3 up) {
	vec3 w = pow(abs(up), vec3(wave_blend_sharpness));
	w /= dot(w, vec3(1.0));
	w = max(w - 0.05, vec3(0.0));
	return w / dot(w, vec3(1.0));
}

// Height-wave displacement at world point p, faded out with distance. `nrm` gets the surface normal,
// `fold` the whitecap mask (see wave_sum).
vec3 ocean_wave(vec3 p, float t, vec3 cam, float spacing, out vec3 nrm, out float fold) {
	vec3 up = normalize(p - planet_center);
	nrm = up;
	fold = 0.0;
	float fade = smoothstep(vertex_wave_fade_max, vertex_wave_fade_min, distance(p, cam));
	if (WaveCount == 0 || fade <= 0.0) {
		return vec3(0.0);
	}
	vec3 w = wave_weights(up);
	vec3 n;
	vec4 wave = wave_sum(0, WaveCount, p, up, w, t, sample_current(up), spacing, n);
	nrm = normalize(mix(up, normalize(n), fade));
	fold = wave.w * fade;
	return wave.xyz * fade;
}

const int RIPPLE_SLICES = 10;

float ripple_segment_distance(vec2 p, vec4 s) {
	vec2 pa = p - s.xy;
	vec2 ba = s.zw - s.xy;
	float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
	return length(pa - ba * h);
}

// Distance (metres) from q to the outline stored in one slice row (1e4 when empty); r_radius gets
// that outline's size.
float ripple_slice_distance(int row, vec2 q, out float r_radius) {
	vec4 head = texelFetch(ripple_segments, ivec2(0, row), 0);
	int n = int(head.r);
	r_radius = head.g;
	float d = 1e4;
	for (int k = 0; k < n; k++) {
		d = min(d, ripple_segment_distance(q, texelFetch(ripple_segments, ivec2(k + 1, row), 0)));
	}
	return d;
}

// Distance from water point p to object i's outline at p's own height, and (r_radius) that outline's
// size; 1e4 = no contact. Strict: water below the lowest slice or above the highest does not touch
// the object, so foam only starts once the water actually reaches it.
float ripple_distance(int i, vec3 p, float reach, out float r_radius) {
	r_radius = 0.0;
	vec3 rel = p - ripple_origin[i].xyz;
	vec3 up = ripple_up[i].xyz;
	vec3 east = ripple_east[i].xyz;
	vec2 q = vec2(dot(rel, east), dot(rel, cross(up, east)));
	if (length(q) > ripple_up[i].w + reach) {
		return 1e4;
	}
	float h = dot(rel, up);
	float z0 = ripple_east[i].w;
	float z1 = ripple_zmax[i];
	if (h < z0 || h > z1) {
		return 1e4;
	}
	float s = (h - z0) / max(z1 - z0, 1e-4) * float(RIPPLE_SLICES - 1);
	int s0 = min(int(floor(s)), RIPPLE_SLICES - 1);
	int s1 = min(s0 + 1, RIPPLE_SLICES - 1);
	float r0;
	float r1;
	float d0 = ripple_slice_distance(i * RIPPLE_SLICES + s0, q, r0);
	float d1 = ripple_slice_distance(i * RIPPLE_SLICES + s1, q, r1);
	// Blend between slices; where one is empty (past a concavity), use the other.
	if (d0 >= 1e3) {
		r_radius = r1;
		return d1;
	}
	if (d1 >= 1e3) {
		r_radius = r0;
		return d0;
	}
	float f = s - float(s0);
	r_radius = mix(r0, r1, f);
	return mix(d0, d1, f);
}

// Foam around ripple objects at water point p: a solid collar at the waterline, a tinted edge line
// just outside it (edge_out), and shape-following lines drifting slowly outward, broken up by
// `noise` (0..1) and fading with distance. Distances come from the nearest object's waterline, and
// `cur` (the local current, xyz tangent direction, w strength) decides which side of the object the
// foam gathers on.
float ripple_foam_at(vec3 p, float t, float noise, vec4 cur, out float edge_out) {
	edge_out = 0.0;
	float best = 1e9;
	float strength = 0.0;
	float radius = 0.0;
	vec3 best_rel = vec3(0.0);
	for (int i = 0; i < ripple_count; i++) {
		float r;
		float d = ripple_distance(i, p, ripple_reach + ripple_warp, r);
		if (d < best) {
			best = d;
			radius = r;
			strength = ripple_origin[i].w;
			best_rel = p - ripple_origin[i].xyz;
		}
	}
	// The foam spreads in proportion to how much of the object is in the water here: a corner just
	// dipping in gets a small collar, a fully immersed hull the full ripple_reach.
	float reach = min(ripple_reach, ripple_contact_width + radius * 1.5);
	if (best > reach || strength <= 0.0) {
		return 0.0;
	}
	float d = max(best + (noise - 0.5) * ripple_warp * smoothstep(0.0, ripple_contact_width, best), 0.0);
	float collar = 1.0 - smoothstep(ripple_contact_width * 0.6, ripple_contact_width, d);
	float edge_d = abs(d - ripple_contact_width - 0.12);
	edge_out = (1.0 - smoothstep(0.04, 0.12, edge_d)) * strength;
	float phase = fract((d - ripple_contact_width - t * ripple_speed) / ripple_line_spacing);
	float line = 1.0 - smoothstep(ripple_line_width * 0.5, ripple_line_width, abs(phase - 0.5) * 2.0);
	line *= step(ripple_contact_width, d);
	float fade = 1.0 - smoothstep(0.0, reach, d);
	// Torn: noise below a threshold that rises with distance removes the line there entirely.
	float tear = 1.0 - smoothstep(0.0, 0.12, ripple_breakup * (0.6 + 0.8 * (1.0 - fade)) - noise);
	// Which side of the object this pixel is on: -1 straight upstream, +1 straight downstream.
	// ponytail: best_rel is used unprojected -- it is a waterline-to-waterline offset, so its
	// vertical part is small and only softens the dot a little. Project it if tall objects look off.
	float wake = ripple_wake * clamp(cur.w * 2.0, 0.0, 1.0);
	if (wake > 0.0 && dot(cur.xyz, cur.xyz) > 1e-4 && dot(best_rel, best_rel) > 1e-6) {
		float down = dot(normalize(best_rel), normalize(cur.xyz));
		// Bow wave upstream, streaks trailing off downstream -- rather than the same ring on every
		// side, which is what made the foam read as contour lines rather than water.
		collar *= mix(1.0, mix(1.3, 0.55, 0.5 + 0.5 * down), wake);
		line *= mix(1.0, smoothstep(-0.1, 0.55, down), wake);
	}
	return clamp(collar + line * fade * tear, 0.0, 1.0) * strength;
}

// Screen-space reflection at view-space surface point pos with view-space normal n: rgb = scene
// colour where the reflected ray hits, a = confidence (0 = keep the sky). Steps are spaced
// quadratically -- dense near the water, where most hits are -- then refined by bisection.
float ssr_scene_z(vec2 uv, mat4 inv_proj) {
	float depth_raw = textureLod(depth_texture, uv, 0.0).r;
	vec4 v = inv_proj * vec4(uv * 2.0 - 1.0, depth_raw, 1.0);
	return v.z / v.w;
}

vec2 ssr_project(vec3 p, mat4 proj) {
	vec4 c = proj * vec4(p, 1.0);
	return c.xy / c.w * 0.5 + 0.5;
}

vec4 ssr_trace(vec3 pos, vec3 n, vec3 v, mat4 proj, mat4 inv_proj) {
	vec3 r = normalize(reflect(-v, n));
	if (r.z > 0.5) {
		return vec4(0.0); // heading back at the camera: nothing on screen to hit
	}
	vec3 prev = pos;
	for (int i = 1; i <= ssr_steps; i++) {
		float f = float(i) / float(ssr_steps);
		float t = ssr_max_distance * f * f;
		vec3 p = pos + r * t;
		if (p.z > -0.05) {
			break;
		}
		vec2 uv = ssr_project(p, proj);
		if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
			break;
		}
		float diff = ssr_scene_z(uv, inv_proj) - p.z;
		if (diff > 0.0 && diff < ssr_thickness + t * 0.05) {
			vec3 a = prev;
			vec3 b = p;
			for (int k = 0; k < 4; k++) {
				vec3 m = (a + b) * 0.5;
				if (ssr_scene_z(ssr_project(m, proj), inv_proj) - m.z > 0.0) {
					b = m;
				} else {
					a = m;
				}
			}
			vec2 hit = ssr_project(b, proj);
			float edge = smoothstep(0.0, 0.08, min(min(hit.x, 1.0 - hit.x), min(hit.y, 1.0 - hit.y)));
			float far_fade = 1.0 - smoothstep(0.6, 1.0, f);
			return vec4(textureLod(screen_texture, hit, 0.0).rgb, edge * far_fade * ssr_strength);
		}
		prev = p;
	}
	return vec4(0.0);
}

// Screen-space shadow for the sun/moon glint (the water is shadows_disabled, so without this the
// sun reflected off the sea straight through the hills that hide it). Marches from the water point
// toward the light; it is blocked where the depth buffer holds something farther from the camera
// than the water pixel (so the player standing in front never casts a strip across the glint) yet
// in front of the ray. Steps are exponential, 2 m out to ~4 km, to reach a ridge on the horizon.
// ponytail: only what is on screen can block it; a shadow-cascade read would catch off-screen
// occluders, at the per-pixel cost the shadows_disabled note above measured.
float glint_occlusion(vec3 pos, vec3 l, mat4 proj, mat4 inv_proj) {
	for (int i = 0; i < 14; i++) {
		float t = 2.0 * pow(2000.0, float(i) / 13.0);
		vec3 p = pos + l * t;
		if (p.z > -0.05) {
			return 1.0;
		}
		vec2 uv = ssr_project(p, proj);
		if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
			return 1.0;
		}
		float scene_z = ssr_scene_z(uv, inv_proj);
		if (scene_z < pos.z - 1.0 && scene_z - p.z > 1.0) {
			return 0.0;
		}
	}
	return 1.0;
}

// Godot's own directional-light BRDF (scene_forward_lights_inc.glsl: Burley diffuse, Schlick-GGX
// specular with its D_GGX / V_GGX / f90 terms), for lighting_mode = Fast. View space throughout.
void fast_direct_light(vec3 n, vec3 v, vec3 l, vec3 col, float spec_amount, float rough, float spec, float size,
		inout vec3 diffuse, inout vec3 specular_out) {
	// `size` widens the light the way Godot's light_compute does with its A term
	float ndl = min(size + dot(n, l), 1.0);
	if (ndl <= 0.0) {
		return;
	}
	vec3 h = normalize(v + l);
	float ndv = clamp(dot(n, v), 0.0, 1.0);
	float ldh = clamp(size + dot(l, h), 0.0, 1.0);
	float ndh = clamp(size + dot(n, h), 0.0, 1.0);
	float fd90m1 = 2.0 * ldh * ldh * rough - 0.5;
	float fdv = 1.0 + fd90m1 * pow(1.0 - ndv, 5.0);
	float fdl = 1.0 + fd90m1 * pow(1.0 - ndl, 5.0);
	diffuse += col * (fdv * fdl * ndl / PI);
	float a = rough * rough;
	float ad = ndh * a;
	float k = a / (1.0 - ndh * ndh + ad * ad);
	float dd = min(k * k / PI, 65504.0);
	float vv = min(0.5 / mix(2.0 * ndl * ndv, ndl + ndv, a), 65504.0);
	float f0 = 0.16 * spec * spec;
	float f90 = clamp(f0 * 50.0, 0.0, 1.0);
	float f = f0 + (f90 - f0) * pow(1.0 - ldh, 5.0);
	specular_out += col * (ndl * dd * f * vv * spec_amount);
}

void vertex() {
	float time = freeze_time ? 0.0 : TIME;
	vec3 cam = (INV_VIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

	// Geomorph (CDLOD): CUSTOM0/CUSTOM1 hold the two parent-grid vertices this vertex sits between
	// (zero for vertices the parent also has). Toward lod_range the vertex -- base position AND wave
	// displacement -- slides onto the parent's linear interpolation. The factor comes from the
	// vertex's own camera distance, so neighbouring patches agree along shared edges, and at the
	// moment of a split or merge the two meshes are identical: nothing pops.
	vec3 vlocal = VERTEX; // patch-local, full precision
	vec3 p = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; // world, where the wave field is defined
	// Camera distance at which this patch's vertices are fully morphed onto its parent's grid (the
	// parent's split distance); 0 = root patch, never morphs. Baked into every vertex by
	// EdenPlanetOcean rather than being an instance uniform: those come out of one small global
	// buffer, and 1 m LOD0 triangles put enough patches on screen to exhaust it.
	float lod_range = CUSTOM1.w;
	// Root patches carry no lod_range, so nothing says how coarse they are; they are only ever drawn
	// far from the camera, where the waves have faded out anyway, so call them infinitely coarse.
	float spacing = lod_range > 0.0 ? lod_range * lod_vertex_spacing : 1e6;
	float morph = 0.0;
	vec3 pa = p;
	vec3 pb = p;
	if (lod_blend && lod_range > 0.0 && dot(CUSTOM0.xyz, CUSTOM0.xyz) > 0.0) {
		morph = smoothstep(lod_morph_start * lod_range, lod_range, distance(cam, p));
		pa = p + (MODEL_MATRIX * vec4(CUSTOM0.xyz, 0.0)).xyz;
		pb = p + (MODEL_MATRIX * vec4(CUSTOM1.xyz, 0.0)).xyz;
	}
	vec3 n = normalize(p - planet_center);
	vec3 disp = vec3(0.0);
	float fold = 0.0;
	if (morph < 1.0) {
		disp = ocean_wave(p, time, cam, spacing, n, fold);
	}
	if (morph > 0.0) {
		vec3 na;
		vec3 nb;
		float fold_a;
		float fold_b;
		// The parent's own spacing, so at morph = 1 this patch reproduces the parent's wave field
		// exactly -- band limiting included -- and the split/merge stays invisible.
		vec3 da = ocean_wave(pa, time, cam, spacing * 2.0, na, fold_a);
		vec3 db = ocean_wave(pb, time, cam, spacing * 2.0, nb, fold_b);
		vec3 p_unmorphed = p;
		p = mix(p, 0.5 * (pa + pb), morph);
		vlocal += p - p_unmorphed; // the same translation, in the precise frame
		disp = mix(disp, 0.5 * (da + db), morph);
		n = normalize(mix(n, normalize(na + nb), morph));
		fold = mix(fold, 0.5 * (fold_a + fold_b), morph);
	}

	vec3 up = normalize(p - planet_center);
	world_coordinates = p;
	current_sample = sample_current(up);
	float distance_from_camera = distance(p, cam);

	// Triplanar texture UVs (upstream, driven by the sphere normal instead of the mesh normal).
	uv_power_normal = pow(abs(up), vec3(uv_blend_sharpness));
	uv_power_normal /= dot(uv_power_normal, vec3(1.0));
	uv_tri = p / uv_tri_scale + uv_tri_offset;
	uv_tri *= vec3(1.0, -1.0, 1.0);

	wave_fold = fold;
	// UV detail waves only matter where the surface detail is still visible.
	if (distance_from_camera < foam_fade_max && UVWaveCount > 0) {
		vec3 unused_n;
		uv_tri += wave_sum(1, UVWaveCount, uv_tri, up, wave_weights(up), time, current_sample, 0.0, unused_n).xyz;
	}
	// Foam and refraction detail are carried by the local current, so froth streaks run downstream
	// with the waves instead of sliding along a fixed world diagonal the way upstream's constant
	// offset did. The two layers drift opposite ways so they shear against each other.
	vec3 drift = current_sample.xyz * current_sample.a * foam_drift_speed * time
			/ uv_tri_scale * vec3(1.0, -1.0, 1.0);
	refraction_uv_tri = uv_tri - drift * 0.5;
	uv_tri += drift;

	low_poly_fade = 1.0 - smoothstep(low_poly_max_facet * 0.5, low_poly_max_facet, spacing);
	// ...and fade them out again once a triangle gets small on screen. A face normal from screen-space
	// derivatives is only that triangle's while the pixel quad sits inside it; on a quad straddling an
	// edge it is neither triangle's, and once triangles are a few pixels wide most quads straddle one,
	// which peppers the distance with dark dashes. Twenty pixels is where that stops showing.
	float facet_px = spacing * abs(PROJECTION_MATRIX[1][1]) * VIEWPORT_SIZE.y * 0.5
			/ max(distance_from_camera, 1e-3);
	low_poly_fade *= smoothstep(8.0, 20.0, facet_px);
	facet_fold = fold;

	skirt = CUSTOM0.w;
	vlocal += disp; // disp is a world direction, and patches are translation-only, so it is local too
	VERTEX = vlocal;
	NORMAL = n;
	world_coordinates = p + disp;
	local_pos = vlocal;
}

// Samples only the planes with a meaningful weight. Gradients come from the caller (taken outside
// any branch), so skipping planes per pixel can't corrupt mip selection.
vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p, vec3 dx, vec3 dy) {
	vec4 samp = vec4(0.0);
	float used = 0.0;
	if (p_weights.z > 0.02) {
		samp += textureGrad(p_sampler, p.xy, dx.xy, dy.xy) * p_weights.z;
		used += p_weights.z;
	}
	if (p_weights.y > 0.02) {
		samp += textureGrad(p_sampler, p.xz, dx.xz, dy.xz) * p_weights.y;
		used += p_weights.y;
	}
	if (p_weights.x > 0.02) {
		vec2 flip = vec2(-1.0, 1.0);
		samp += textureGrad(p_sampler, p.zy * flip, dx.zy * flip, dy.zy * flip) * p_weights.x;
		used += p_weights.x;
	}
	return samp / max(used, 1e-4);
}

// View-space distance from the water surface to whatever opaque surface is behind it.
float depth_from_water_to_object(vec2 screen_uv, mat4 inv_projection_matrix, mat4 inv_view_matrix, vec3 vertex) {
	float depth_raw = textureLod(depth_texture, screen_uv, 0.0).r;
	// Reverse-Z: 0 is the far plane, i.e. NOTHING opaque behind this pixel at all -- no sea floor
	// loaded, nothing within the frustum. Unprojecting that is a division by ~0, and the sign the
	// infinity lands on then decides between \"infinitely deep\" and \"infinitely shallow\". It came
	// out shallow, which sent see_through to the screen read and left the water refracting raw sky
	// as a flat pale slab (visible looking straight down in --capture, where terrain is hidden; it
	// would hit the same way over any water whose floor has not streamed in yet). No floor within
	// the whole view is unambiguously deep, so say so instead of unprojecting infinity.
	if (depth_raw <= 1e-6) {
		return 1.0e9;
	}
	vec3 ndc = vec3(screen_uv * 2.0 - 1.0, depth_raw);
	vec4 view = inv_projection_matrix * vec4(ndc, 1.0);
	view.xyz /= view.w;
	// The water writes depth -- it has to, so the clouds drawn after it sort against it -- into the
	// same buffer it samples here. So the wave standing between this pixel and the horizon comes
	// back as \"the sea floor, two metres down\", and the whole sea reports itself as its own shallow
	// bottom: hard-edged slabs of shallow-vs-deep colour following the crest lines, painted over
	// with shore foam. Anything within floor_reject_band of sea level is the ocean's own surface or
	// its skirts, so it is not a floor.
	// ponytail: a band, not an exact \"is this pixel water\" test, because nothing in the depth buffer
	// says which object wrote it. The alternative is to stop the water writing depth and give the
	// cloud shell its own horizon test instead; worth it only if the band ever costs real shoreline.
	vec3 world = (inv_view_matrix * vec4(view.xyz, 1.0)).xyz;
	if (abs(length(world - planet_center) - planet_radius) < floor_reject_band) {
		return 1.0e9;
	}
	return -view.z - (-vertex.z);
}

void fragment() {
	// Whether this pixel is the TOP of the water is decided by where the camera is, not by which way
	// the triangle happens to face. Once the view gets shallower than the waves' own slope -- from
	// any height, a few hundred metres out -- the back slope of every wave is a back face, and a
	// wave's back slope is ordinary water seen from above, not a view up through the surface.
	// Reading that off FRONT_FACING alone gave every one of them the underwater treatment (the Snell
	// window: flat dark navy behind a step()), and the discard below removed them outright, which
	// punched wave-shaped holes in the middle distance that showed the sky through. Both read as
	// hard-edged grey slabs lying across the sea.
	bool above_water = distance(CAMERA_POSITION_WORLD, planet_center) > planet_radius + backface_altitude;
	bool water_top = FRONT_FACING || above_water;
	// Sun/moon glint scale: fades out over the last few tens of centimetres of water at the beach,
	// where the screen shows the sand under it -- a full-strength sun blob there reads as the sun
	// reflecting off the sand.
	float shore_glint = 1.0;
	if (!FRONT_FACING && above_water) {
		// What IS worth rejecting up front: the far side of the planet, seen through the near
		// surface. Shading it roughly doubled the ocean's cost. That is the half of the sphere whose
		// local up points away from the camera -- a near wave's back slope is not.
		if (dot(normalize(world_coordinates - planet_center), CAMERA_POSITION_WORLD - world_coordinates) < 0.0) {
			discard;
		}
		NORMAL = -NORMAL; // facing away from us only because the wave is steeper than the view ray
	}
	// Far off at grazing angles the pixel-footprint derivatives can come out parallel (or zero), and
	// normalize() of their zero-length cross product is NaN: black specks along the horizon that glow
	// then smeared into big white blobs. Keep the smooth normal there.
	vec3 face_cross = cross(dFdx(local_pos), dFdy(local_pos));
	if (low_poly_normals && low_poly_fade > 0.0 && dot(face_cross, face_cross) > 1e-24) {
		// True face normal of this triangle, from the precise patch-local position.
		// local_pos is patch-local, and patches carry translation only, so its cross product is a
		// world-space direction; NORMAL and VIEW are view space.
		vec3 fn = normalize(face_cross);
		fn = normalize((VIEW_MATRIX * vec4(fn, 0.0)).xyz);
		fn = dot(fn, VIEW) < 0.0 ? -fn : fn;
		// Tilt it away from the local vertical so neighbouring facets actually differ (see the
		// uniform). Done per facet, so the exaggeration is constant across a triangle and the flat
		// look survives it.
		vec3 up_v = normalize((VIEW_MATRIX * vec4(normalize(world_coordinates - planet_center), 0.0)).xyz);
		up_v = dot(up_v, VIEW) < 0.0 ? -up_v : up_v;
		fn = normalize(up_v + (fn - up_v) * low_poly_relief);
		fn = dot(fn, VIEW) < 0.0 ? -fn : fn; // the tilt can swing a facet past the viewer
		NORMAL = normalize(mix(NORMAL, fn, low_poly_fade));
	}

	if (skirt > 0.001) {
		// Skirt (crack filler hanging below patch edges): only ever glimpsed through a transient LOD
		// gap, yet at grazing angles a view ray crosses several of them underwater. Shading them fully
		// cost more than the whole visible surface (measured: 11 of 20 ms at 1080p), so: flat deep water.
		ALBEDO = color_deep.rgb;
		ROUGHNESS = 1.0;
		SPECULAR = 0.0;
	} else {
		ALPHA = 1.0;
		float distance_from_camera = distance(CAMERA_POSITION_WORLD, world_coordinates);
		vec3 uv_dx = dFdx(uv_tri);
		vec3 uv_dy = dFdy(uv_tri);

		// Past depth_fog_fade_max the water is opaque deep colour: nothing behind it is visible, so the
		// refraction noise and the screen/depth reads can all be skipped (most of the planet from orbit).
		float fog_by_distance = smoothstep(depth_fog_fade_min, depth_fog_fade_max, distance_from_camera);
		bool opaque_far = water_top && fog_by_distance >= 1.0 && color_deep.a >= 1.0;

		// Refraction: offset the screen lookup by a scrolling noise texture, scaled by how much water
		// is actually between this pixel and whatever is behind it (refraction_depth_scale), so an
		// object at the waterline blurs over a few centimetres rather than the whole wave.
		// z_behind is shared with the shoreline band below -- one depth fetch, not two.
		float z_behind = 0.0;
		vec2 ref_uv_offset = vec2(0.0);
		if (!opaque_far) {
			z_behind = depth_from_water_to_object(SCREEN_UV, INV_PROJECTION_MATRIX, INV_VIEW_MATRIX, VERTEX);
			vec4 ref_tex = triplanar_texture(texture_refraction, uv_power_normal, refraction_uv_tri, uv_dx, uv_dy);
			float r_final = refraction * clamp(refraction_scaling_distance_min / distance_from_camera, 0.0, 1.0)
					* clamp(z_behind / refraction_depth_scale, 0.0, 1.0);
			float ref_sample = dot(ref_tex, refraction_texture_channel);
			ref_uv_offset = (NORMAL.xy * ref_sample + ref_sample - 0.5) * r_final;
		}
		vec2 screen_uv = SCREEN_UV - ref_uv_offset;
		if (!opaque_far && water_top) {
			shore_glint = smoothstep(0.0, 0.6, z_behind);
		}
		// The refracted lookup can land on something IN FRONT of the water -- the player wading
		// through it -- whose colour then got pasted into the sea beside them: a ghost copy of the
		// character floating on the water. Only what is behind the surface may be refracted.
		float z_diff_refracted = 1.0e9;
		if (!opaque_far) {
			z_diff_refracted = depth_from_water_to_object(screen_uv, INV_PROJECTION_MATRIX, INV_VIEW_MATRIX, VERTEX);
			if (z_diff_refracted < 0.0) {
				screen_uv = SCREEN_UV;
				ref_uv_offset = vec2(0.0);
				z_diff_refracted = z_behind;
			}
		}

		ALPHA *=smoothstep(distance_fade_max, distance_fade_min, distance_from_camera);
		ALPHA *= smoothstep(near_fade_min, near_fade_max, distance_from_camera);
		float foam_fade_alpha = smoothstep(foam_fade_max, foam_fade_min, distance_from_camera);
		float shore_fade_alpha = smoothstep(shore_fade_max, shore_fade_min, distance_from_camera);
		if (ALPHA <= 0.0) {
			discard;
		}
		METALLIC = metallic;
		SPECULAR = specular;
		ROUGHNESS = roughness;

		vec4 albedo_tex = triplanar_texture(texture_albedo, uv_power_normal, uv_tri, uv_dx, uv_dy);

		float fresnel_factor = fresnel(3.0, NORMAL, VIEW);
		vec4 surface_color = mix(albedo, albedo_fresnel, fresnel_factor);

		// Snell's window: seen from below, only a cone overhead is see-through.
		vec2 snell_offset = ref_uv_offset * 2.0;
		vec3 snell_normal = vec3(NORMAL.x - snell_offset.x, NORMAL.y - snell_offset.y, NORMAL.z);
		float snell_factor = water_top ? 1.0 : snell(snell_tightness, snell_normal, VIEW);
		float final_refraction_opacity = clamp(refraction_opacity * snell_factor, 0.0, 1.0);
		surface_color = mix(albedo_snell, surface_color, snell_factor);

		// Depth fog. Depth precision is useless at orbital distances, so it is forced to \"deep\" with
		// distance (depth_fog_fade_*) -- which is also what makes the ocean read as deep blue from space.
		float depth_blend_power = fog_by_distance;
		if (depth_blend_power < 1.0) {
			float depth_blend = clamp(1.0 - exp((z_diff_refracted + depth_offset) * -beers_law), 0.0, 1.0);
			depth_blend_power = clamp(pow(depth_blend, 2.5) + depth_blend_power, 0.0, 1.0);
		}

		float see_through = (1.0 - surface_color.a * albedo_tex.a) * final_refraction_opacity;
		vec3 fog_color = mix(color_shallow.rgb, color_deep.rgb, depth_blend_power);
		float fog_amount = water_top ? mix(color_shallow.a, color_deep.a, depth_blend_power) : 0.0;
		// Fully fogged water hides the scene behind it: skip the screen read.
		vec3 screen_color = fog_amount < 1.0 ? textureLod(screen_texture, screen_uv, 0.0).rgb : vec3(0.0);

		ALBEDO = surface_color.rgb * albedo_tex.rgb * (1.0 - see_through) + fog_color * see_through * fog_amount;
		EMISSION = screen_color * see_through * (1.0 - fog_amount);

		// Foam: whitecaps where the wave field folds, plus a shoreline band from the depth buffer.
		vec4 foam_tex = vec4(0.0);
		if (foam_fade_alpha > 0.0 || shore_fade_alpha > 0.0) {
			foam_tex = triplanar_texture(texture_foam, uv_power_normal, uv_tri, uv_dx, uv_dy);
		}
		float foam_shape = foam_tex.a;
		if (low_poly_normals) {
			foam_shape = step(1.0 - foam_low_poly_coverage, foam_tex.a);
		}
		// Faceted foam too: the fold is taken per triangle, so a whitecap is a whole facet turning
		// white rather than a hard edge cutting across one at an unrelated angle.
		float fold_here = low_poly_normals ? mix(wave_fold, facet_fold, low_poly_fade) : wave_fold;
		float foam_cut = fold_here - (1.0 - foam_shape) * foam_texture_bite;
		// Stylized: a hard step instead of a gradient. wave_fold is interpolated per vertex, so the
		// cut lands along the triangle edges -- flat polygonal caps to match the flat normals, rather
		// than a soft airbrushed wash draped over facets.
		float crest = smoothstep(foam_crest_start, foam_crest_full, foam_cut);
		if (low_poly_normals) {
			crest = mix(crest, step(foam_crest_start, foam_cut), low_poly_fade);
		}
		crest = clamp(crest, 0.0, 1.0);
		float final_foam_alpha = clamp(crest * foam_amount, 0.0, 1.0) * foam_fade_alpha;
		EMISSION *= 1.0 - final_foam_alpha;
		ALBEDO = mix(ALBEDO, foam_tex.rgb, final_foam_alpha);

		if (ripple_count > 0) {
			// Breakup noise: the smooth refraction noise at a finer scale, so foam lines tear
			// organically instead of reading as perfect vector outlines.
			float n = triplanar_texture(texture_refraction, uv_power_normal, uv_tri * 1.7, uv_dx * 1.7, uv_dy * 1.7).r;
			float edge;
			float rf = ripple_foam_at(world_coordinates, freeze_time ? 0.0 : TIME, n, current_sample, edge) * ripple_foam * ripple_color.a;
			if (low_poly_normals) {
				// Stylized: one hard-edged foam shape, no gradient.
				rf = mix(rf, step(0.35, rf), low_poly_fade);
			}
			EMISSION *= 1.0 - rf;
			ALBEDO = mix(ALBEDO, ripple_color.rgb, rf);
			float re = edge * ripple_edge_color.a * (1.0 - rf);
			EMISSION *= 1.0 - re;
			ALBEDO = mix(ALBEDO, ripple_edge_color.rgb, re);
		}

		// (Never reached with opaque_far, which starts well beyond shore_fade_max, so z_behind is set.)
		if (shore_fade_alpha > 0.0 && water_top) {
			float shore_alpha = clamp(1.0 - smoothstep(shore_start_blend, shore_end_blend, z_behind), 0.0, 1.0);
			shore_alpha *= foam_shape * shore_fade_alpha;
			EMISSION *= 1.0 - shore_alpha;
			ALBEDO = mix(ALBEDO, foam_tex.rgb, shore_alpha);
		}

#ifdef EDEN_OCEAN_FAST_SKY_LIGHT
		{
			// Replaces what ambient_light_disabled switched off: sky reflection (one fetch from the
			// small radiance map) and diffuse sky ambient (the ambient cube, blended by the squared
			// normal).
			vec3 n_w = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
			vec3 r_w = reflect(-normalize((INV_VIEW_MATRIX * vec4(VIEW, 0.0)).xyz), n_w);
			vec3 sky = sky_fallback_color;
			vec3 amb = sky_fallback_color;
			if (sky_map_valid) {
				vec2 uv = vec2(atan(r_w.z, r_w.x) / TAU + 0.5, acos(clamp(r_w.y, -1.0, 1.0)) / PI);
				sky = textureLod(sky_radiance_map, uv, 0.0).rgb;
				vec3 n2 = n_w * n_w;
				amb = n2.x * (n_w.x > 0.0 ? sky_ambient_px : sky_ambient_nx)
						+ n2.y * (n_w.y > 0.0 ? sky_ambient_py : sky_ambient_ny)
						+ n2.z * (n_w.z > 0.0 ? sky_ambient_pz : sky_ambient_nz);
			}
#ifdef EDEN_OCEAN_SSR
			if (water_top) {
				vec4 ssr = ssr_trace(VERTEX, NORMAL, VIEW, PROJECTION_MATRIX, INV_PROJECTION_MATRIX);
				sky = mix(sky, ssr.rgb, ssr.a);
			}
#endif
			// Same environment-BRDF approximation (Karis) Godot applies to its radiance reflections,
			// so the fast path matches the brightness it replaces.
			float f0 = 0.16 * specular * specular;
			float ndv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
			vec4 r = roughness * vec4(-1.0, -0.0275, -0.572, 0.022) + vec4(1.0, 0.0425, 1.04, -0.04);
			float a004 = min(r.x * r.x, exp2(-9.28 * ndv)) * r.x + r.y;
			vec2 env_ab = vec2(-1.04, 1.04) * a004 + r.zw;
			EMISSION += (sky * (f0 * env_ab.x + env_ab.y) + ALBEDO * amb) * sky_light_energy;
		}
#endif
		if (debug_show_currents) {
			// Hue = compass heading (east/north frame), brightness = strength.
			vec3 up = normalize(world_coordinates - planet_center);
			vec3 east = normalize(cross(vec3(0.0, 1.0, 0.0), up) + vec3(1e-5, 0.0, 0.0));
			vec3 north = cross(up, east);
			float ang = atan(dot(current_sample.xyz, north), dot(current_sample.xyz, east));
			ALBEDO = vec3(0.0);
			EMISSION = (0.5 + 0.5 * cos(ang + vec3(0.0, 2.094, 4.189))) * current_sample.a * 2.0;
		}
	}

#ifdef EDEN_OCEAN_FAST_LIGHT
	// Unshaded outputs ALBEDO only: direct light computed here, EMISSION (refraction, sky
	// reflection/ambient) folded in.
	{
		vec3 diffuse = vec3(0.0);
		vec3 spec_light = vec3(0.0);
		// NORMAL is the raw interpolant, a little short of unit length between vertices; Godot normalizes it
		// after fragment() and lights with that. Unnormalized, N.H never reached the sharp GGX peak and the
		// sun glint seen from orbit came out a dim speckle instead of Fast Sky's bright blob.
		vec3 nn = normalize(NORMAL);
		// Godot's roughness limiter, as in scene_forward_clustered.glsl (see the uniform). Top level, so the
		// derivatives are taken in uniform control flow.
		float light_roughness = ROUGHNESS;
		if (fast_roughness_limiter_amount > 0.0) {
			vec3 dndu = dFdx(nn);
			vec3 dndv = dFdy(nn);
			float variance = fast_roughness_limiter_amount * (dot(dndu, dndu) + dot(dndv, dndv));
			light_roughness = sqrt(min(1.0, ROUGHNESS * ROUGHNESS + min(2.0 * variance, fast_roughness_limiter_limit)));
		}
		for (int i = 0; i < fast_light_count; i++) {
			vec3 l = normalize((VIEW_MATRIX * vec4(fast_light_direction[i], 0.0)).xyz);
			vec3 s = vec3(0.0);
			fast_direct_light(nn, VIEW, l, fast_light_color[i], fast_light_specular[i], light_roughness, SPECULAR, fast_light_size[i], diffuse, s);
			// Only pixels with a visible glint pay for the march.
			if (skirt <= 0.001 && max(s.r, max(s.g, s.b)) > 0.02) {
				s *= glint_occlusion(VERTEX, l, PROJECTION_MATRIX, INV_PROJECTION_MATRIX);
			}
			spec_light += s * shore_glint;
		}
		ALBEDO = EMISSION + ALBEDO * diffuse + spec_light;
	}
#endif
}"

