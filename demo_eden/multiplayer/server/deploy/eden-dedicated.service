[Unit]
Description=Eden dedicated server agent (headless Godot: joins the world as admin, simulates and sends the weather)
After=eden-world-server.service eden-world-bootstrap.service
Requires=eden-world-server.service

[Service]
WorkingDirectory=%h/eden-server/dedicated
ExecStart=%h/eden-server/dedicated/eden_server --headless --flush-stdout --main-pack %h/eden-server/dedicated/eden.pck res://server/eden_server.tscn -- --server --stdb=ws://127.0.0.1:3180 --db=eden-test --cli-config=%h/.config/spacetime/cli.toml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
