[Unit]
Description=Eden dedicated world server (SpacetimeDB, port 3180)

[Service]
ExecStart=%h/eden-server/stdb/spacetime start --listen-addr 0.0.0.0:3180 --data-dir %h/eden-server/.stdb
Restart=on-failure
# spacetime start spawns the real server as a child
KillMode=control-group

[Install]
WantedBy=default.target
